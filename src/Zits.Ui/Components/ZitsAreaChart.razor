@namespace Zits.Ui
@using System.Text

@* Hand-rolled area chart — no recharts. A filled area path plus a stroked top line
   per series over a fixed 0..100 viewBox (preserveAspectRatio="none"), both coloured
   with var(--color-<key>) from the cascaded ChartConfig. Hovering a category drives
   the floating ZitsChartTooltip. *@
<div class="flex h-full w-full flex-col gap-2" data-chart-active="@(_hover is not null ? "" : null)"
     @onmouseleave="() => SetHover(null)">
    <div class="relative min-h-0 flex-1">
        <svg class="block h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none">
            <ZitsChartPatterns Keys="_keys" />
            @if (ShowGrid)
            {
                @foreach (var gy in GridLines())
                {
                    <line class="grid-line" x1="0" x2="100" y1="@ChartMath.N(gy)" y2="@ChartMath.N(gy)"
                          stroke-width="0.5" vector-effect="non-scaling-stroke" />
                }
            }
            @foreach (var key in _keys)
            {
                <path @key="Chart?.AnimationKey(key)" class="chart-series chart-reveal-cartesian"
                      d="@AreaPath(key)" fill="@Fill(key)" fill-opacity="@FillOpacity(key)" stroke="none"
                      data-series-key="@key"
                      style="--chart-series-color:var(--color-@(key))"
                      @onclick="() => ToggleSeriesAsync(key)" />
            }
            @foreach (var key in _keys)
            {
                <path class="chart-series chart-reveal-cartesian" d="@LinePath(key)" fill="none"
                      data-series-key="@key"
                      stroke="var(--color-@(key))" stroke-opacity="@SeriesOpacity(key)" stroke-width="2"
                      stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
            }
            @for (var i = 0; i < _keys.Count; i++)
            {
                var key = _keys[i];
                if (SparklePoint(key) is { } sparkle)
                {
                    <ZitsChartSparkle X="sparkle.X" Y="sparkle.Y" SeriesKey="key" Delay="@(i * 370)" />
                }
            }
            @if (_hover is int hc)
            {
                <line class="grid-line" x1="@ChartMath.N(ChartMath.SlotCenter(hc, _count))" x2="@ChartMath.N(ChartMath.SlotCenter(hc, _count))"
                      y1="@ChartMath.N(ChartMath.Top)" y2="@ChartMath.N(ChartMath.Bottom)"
                      stroke-width="1" vector-effect="non-scaling-stroke" />
            }
            @for (var i = 0; i < _count; i++)
            {
                var idx = i;
                <rect x="@ChartMath.N(idx * _slot)" y="0" width="@ChartMath.N(_slot)" height="100"
                      fill="transparent" pointer-events="all"
                      @onmouseover="() => SetHover(idx)" @onmousemove="() => SetHover(idx)" />
            }
        </svg>
        @if (ShowTooltip && _hover is int ht && ht < _count)
        {
            <ZitsChartTooltip Left="ChartMath.SlotCenter(ht, _count)" Top="TooltipTop(ht)">
                <ZitsChartTooltipContent Label="@_points[ht].Label" Payload="PayloadFor(ht)" />
            </ZitsChartTooltip>
        }
    </div>
    @if (ShowXAxis && _count > 0)
    {
        <div class="flex">
            @foreach (var p in _points)
            {
                <div class="min-w-0 flex-1 truncate text-center text-muted-foreground">@p.Label</div>
            }
        </div>
    }
</div>

@code {
    /// <summary>Rows of data: a category label + per-series-key values.</summary>
    [Parameter] public IEnumerable<ChartDataPoint>? Data { get; set; }

    /// <summary>Series keys to plot, in order. Defaults to the cascaded ChartConfig's keys.</summary>
    [Parameter] public IReadOnlyList<string>? Series { get; set; }

    [Parameter] public bool ShowTooltip { get; set; } = true;
    [Parameter] public bool ShowGrid { get; set; } = true;
    [Parameter] public bool ShowXAxis { get; set; } = true;

    [CascadingParameter] private ZitsChartContainer? Chart { get; set; }

    private List<ChartDataPoint> _points = new();
    private IReadOnlyList<string> _keys = Array.Empty<string>();
    private double _yMax = 1;
    private int _count;
    private double _slot = 100;
    private int? _hover;

    protected override void OnParametersSet()
    {
        _points = Data?.ToList() ?? new();
        _keys = Series ?? Chart?.EffectiveConfig.Keys.ToList() ?? new List<string>();
        _count = _points.Count;
        _slot = _count == 0 ? 100 : 100.0 / _count;
        _yMax = ChartMath.NiceMax(_points, _keys);
    }

    private void SetHover(int? i)
    {
        if (_hover != i) _hover = i;
    }

    private string Fill(string key) => Chart?.Fill(key) ?? $"var(--color-{key})";

    private string FillOpacity(string key)
        => SeriesOpacity(key, Chart?.FillVariant(key) == ChartFillVariant.Solid ? 0.2 : 1);

    private string SeriesOpacity(string key, double normal = 1)
        => Chart?.SeriesOpacity(key, normal) ?? ChartMath.N(normal);


    private Task ToggleSeriesAsync(string key) => Chart?.ToggleSeriesAsync(key) ?? Task.CompletedTask;

    private List<(double X, double Y)> SeriesPoints(string key)
    {
        var pts = new List<(double X, double Y)>();
        for (int i = 0; i < _count; i++)
            if (_points[i].Values.TryGetValue(key, out var v))
                pts.Add((ChartMath.SlotCenter(i, _count), ChartMath.Y(v, _yMax)));
        return pts;
    }

    private (double X, double Y)? SparklePoint(string key)
    {
        var points = SeriesPoints(key);
        return points.Count == 0 ? null : points.MinBy(point => point.Y);
    }

    private string LinePath(string key)
    {
        var pts = SeriesPoints(key);
        var sb = new StringBuilder();
        for (int i = 0; i < pts.Count; i++)
            sb.Append(i == 0 ? 'M' : 'L').Append(' ').Append(ChartMath.N(pts[i].X)).Append(' ').Append(ChartMath.N(pts[i].Y)).Append(' ');
        return sb.ToString();
    }

    private string AreaPath(string key)
    {
        var pts = SeriesPoints(key);
        if (pts.Count == 0) return string.Empty;

        var sb = new StringBuilder();
        sb.Append('M').Append(' ').Append(ChartMath.N(pts[0].X)).Append(' ').Append(ChartMath.N(ChartMath.Bottom)).Append(' ');
        foreach (var p in pts)
            sb.Append('L').Append(' ').Append(ChartMath.N(p.X)).Append(' ').Append(ChartMath.N(p.Y)).Append(' ');
        sb.Append('L').Append(' ').Append(ChartMath.N(pts[^1].X)).Append(' ').Append(ChartMath.N(ChartMath.Bottom)).Append(' ').Append('Z');
        return sb.ToString();
    }

    private IEnumerable<double> GridLines()
    {
        for (int t = 0; t <= 4; t++) yield return ChartMath.Y(_yMax * t / 4, _yMax);
    }

    private double TooltipTop(int i)
    {
        double top = ChartMath.Bottom;
        foreach (var k in _keys)
            if (_points[i].Values.TryGetValue(k, out var v))
                top = Math.Min(top, ChartMath.Y(v, _yMax));
        return Math.Max(0, top - 2);
    }

    private IReadOnlyList<ChartTooltipPayloadItem> PayloadFor(int i)
        => _keys.Where(k => _points[i].Values.ContainsKey(k))
                .Select(k => new ChartTooltipPayloadItem(k, _points[i].Values[k]))
                .ToList();
}
